---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveView from '../../components/ArchiveView.astro';
import { getAllTags, getPublishedPosts } from '../../lib/posts';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = getAllTags(posts);
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { selectedTag: tag },
  }));
}

const { selectedTag } = Astro.props as { selectedTag: string };
---

<BaseLayout
  title={`标签：${selectedTag}`}
  description={`${SITE.title} 中标记为 ${selectedTag} 的文章`}
>
  <ArchiveView selectedTag={selectedTag} />
</BaseLayout>
